# Python 编译文件
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# 虚拟环境
venv/
.venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 运行时生成的目录
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep

# 系统文件
Thumbs.db
.DS_Store
Desktop.ini

# 日志
*.log

# 配置文件：cfg.yml 含 API Key 等敏感信息，禁止入库；只提交模板
**/*.yml
!cfg.yml.template
!**/cfg.yml.template


