# ============================================
# 党政机关公文格式审核与修订系统 - 配置模板
# ============================================
# 使用方式：复制本文件为 cfg.yml，填入真实信息后启动
# ---------------------------------------------------------------------------
# WPS/Word COM 设置
# ---------------------------------------------------------------------------

com:
  # 应用程序 ProgID，根据安装的软件选择：
  #   WPS 企业版:  "WPS.Application"
  #   WPS 专业版:  "WPS.Application"
  #   Word:        "Word.Application"
  # 也可写成列表自动探测：["WPS.Application", "Word.Application"]
  prog_id: "WPS.Application"

  # 是否显示 WPS/Word 窗口（调试时可设为 true）
  visible: false

  # 是否弹出保存警告对话框
  display_alerts: false

# ---------------------------------------------------------------------------
# LLM API 设置（OpenAI 兼容格式）
# ---------------------------------------------------------------------------

llm:
  # 公司大模型 API 地址
  api_base: "https://your-company-api.example.com/v1"

  # API Key
  api_key: "sk-your-api-key-here"

  # 模型名称
  model: "your-model-name"

  # 超时时间（秒）
  timeout: 120

  # 温度（0 = 最确定，1 = 最随机）
  temperature: 0.1

  # 最大输出 token
  max_tokens: 4096

# ---------------------------------------------------------------------------
# 审核设置
# ---------------------------------------------------------------------------

review:
  # 是否启用格式规则检查
  enable_rules: true

  # 是否启用 LLM 内容审核
  enable_llm: true

  # 规则引擎严格程度：strict / normal / loose
  strictness: "normal"

# ---------------------------------------------------------------------------
# 服务设置
# ---------------------------------------------------------------------------

server:
  host: "127.0.0.1"
  port: 8080

  # 上传文件最大大小（MB）
  max_upload_mb: 20

  # 输出目录
  output_dir: "./output"

  # 上传暂存目录
  upload_dir: "./uploads"

  # 任务清理时间（天）
  cleanup_days: 7